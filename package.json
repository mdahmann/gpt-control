{
  "name": "gpt-control",
  "version": "0.3.1",
  "description": "Hardened signed-in ChatGPT web control with exact conversations, durable runs, and bounded Codex Pro workers",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/wolfiesch/gpt-control",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wolfiesch/gpt-control.git"
  },
  "keywords": [
    "gpt-control",
    "model-review",
    "cross-model",
    "openai",
    "agent-tools",
    "coding-agent",
    "browser-automation",
    "oh-my-pi",
    "omp",
    "pi-extension",
    "pi-coding-agent",
    "codex"
  ],
  "files": [
    "src",
    "bin",
    "dist",
    "skills",
    "docs",
    "scripts",
    ".codex-plugin",
    ".mcp.json",
    "agents",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "MIGRATION.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "bin": {
    "gpt-control-mcp": "./bin/gpt-control-mcp"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test",
    "mcp": "./bin/gpt-control-mcp",
    "verify:security": "bash scripts/verify-security.sh",
    "prepack": "bun run build:mcp && bun run check && bun test && bash scripts/verify-security.sh",
    "build:mcp": "bun build src/mcp.ts --target=node --outfile=dist/gpt-control-mcp.js"
  },
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sinclair/typebox": "^0.34.52",
    "node-html-parser": "^9.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "bun": "1.4.0"
  }
}
