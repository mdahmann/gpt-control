{
  "name": "gpt-control",
  "version": "0.2.0",
  "description": "A trustworthy cross-model review broker for coding agents: real runs, structured findings, attachment receipts, and Chrome Bridge, Codex, or Responses transports",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/wolfiesch/gpt-control",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wolfiesch/gpt-control.git"
  },
  "keywords": [
    "gpt-control",
    "model-review",
    "cross-model",
    "openai",
    "agent-tools",
    "coding-agent",
    "browser-automation",
    "oh-my-pi",
    "omp",
    "pi-extension",
    "pi-coding-agent",
    "codex"
  ],
  "files": [
    "src",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "gpt-control-mcp": "./src/mcp.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test",
    "mcp": "bun src/mcp.ts"
  },
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/codex-sdk": "^0.149.0",
    "@sinclair/typebox": "^0.34.52",
    "node-html-parser": "^9.0.1",
    "openai": "^7.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
